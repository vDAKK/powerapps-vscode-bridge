{
  "manifest_version": 3,
  "name": "Power Apps ↔ VS Code Bridge",
  "version": "0.1.0",
  "description": "Live two-way sync between the Power Apps Studio formula bar and VS Code.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://*.powerapps.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Power Apps ↔ VS Code",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.powerapps.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.powerapps.com/*"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
