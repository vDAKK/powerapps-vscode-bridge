{
  "name": "powerapps-bridge",
  "displayName": "Power Apps X VS Code",
  "description": "%extension.description%",
  "publisher": "WavyPanda",
  "version": "0.7.0",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#4C3BCF",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vDAKK/powerapps-vscode-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/vDAKK/powerapps-vscode-bridge/issues"
  },
  "homepage": "https://github.com/vDAKK/powerapps-vscode-bridge#readme",
  "keywords": [
    "power apps",
    "power fx",
    "canvas app",
    "power platform",
    "low-code"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "powerfx",
        "aliases": [
          "Power Fx",
          "powerfx"
        ],
        "extensions": [
          ".fx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "powerfx",
        "scopeName": "source.powerfx",
        "path": "./syntaxes/powerfx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "powerappsBridge.restart",
        "title": "%command.restart%",
        "category": "%command.category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "powerappsBridge.toggleFollow",
        "title": "%command.toggleFollow%",
        "category": "%command.category%",
        "icon": "$(eye)"
      },
      {
        "command": "powerappsBridge.showLog",
        "title": "%command.showLog%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "powerappsBridge.goToFormula",
        "title": "%command.goToFormula%",
        "icon": "$(go-to-file)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.goToProperty",
        "title": "%command.goToProperty%",
        "icon": "$(symbol-property)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.goToControl",
        "title": "%command.goToControl%",
        "icon": "$(search)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.refreshTree",
        "title": "%command.refreshTree%",
        "icon": "$(refresh)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.expandTree",
        "title": "%command.expandTree%",
        "icon": "$(expand-all)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.selectControl",
        "title": "%command.selectControl%",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.openFormula",
        "title": "%command.openFormula%",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.loadProperties",
        "title": "%command.loadProperties%",
        "icon": "$(cloud-download)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.showPreview",
        "title": "%command.showPreview%",
        "icon": "$(preview)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.revealInPreview",
        "title": "%command.revealInPreview%",
        "icon": "$(eye)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.copyName",
        "title": "%command.copyName%",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.help",
        "title": "%command.help%",
        "icon": "$(question)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.openWalkthrough",
        "title": "%command.openWalkthrough%",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.exportApp",
        "title": "%command.exportApp%",
        "icon": "$(cloud-download)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.renameControl",
        "title": "%command.renameControl%",
        "icon": "$(edit)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.pickProperty",
        "title": "%command.pickProperty%",
        "icon": "$(symbol-property)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.suggestNames",
        "title": "%command.suggestNames%",
        "icon": "$(symbol-key)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.searchFormulas",
        "title": "%command.searchFormulas%",
        "icon": "$(search-fuzzy)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.findUsages",
        "title": "%command.findUsages%",
        "icon": "$(references)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.runLint",
        "title": "%command.runLint%",
        "icon": "$(lightbulb)",
        "category": "%command.category%"
      },
      {
        "command": "powerappsBridge.forgetBrowsers",
        "title": "%command.forgetBrowsers%",
        "category": "%command.category%"
      }
    ],
    "configuration": {
      "title": "Power Apps X VS Code",
      "properties": {
        "powerappsBridge.port": {
          "type": "number",
          "default": 8765,
          "description": "%setting.port%"
        },
        "powerappsBridge.followSelection": {
          "type": "boolean",
          "default": true,
          "description": "%setting.followSelection%"
        },
        "powerappsBridge.navigateOnEdit": {
          "type": "boolean",
          "default": true,
          "description": "%setting.navigateOnEdit%"
        },
        "powerappsBridge.singleTab": {
          "type": "boolean",
          "default": true,
          "description": "%setting.singleTab%"
        },
        "powerappsBridge.mirrorFolder": {
          "type": "string",
          "default": ".powerapps",
          "markdownDescription": "%setting.mirrorFolder%"
        },
        "powerappsBridge.exportOnConnect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.exportOnConnect%"
        },
        "powerappsBridge.syncFromDisk": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.syncFromDisk%"
        },
        "powerappsBridge.loadFullTree": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.loadFullTree%"
        },
        "powerappsBridge.lint": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.lint%"
        },
        "powerappsBridge.formatWidth": {
          "type": "number",
          "default": 80,
          "minimum": 40,
          "description": "%setting.formatWidth%"
        }
      }
    },
    "configurationDefaults": {
      "[powerfx]": {
        "files.trimTrailingWhitespace": false,
        "files.insertFinalNewline": false,
        "files.trimFinalNewlines": false,
        "editor.formatOnSave": false
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "powerappsBridge.goToControl",
          "when": "resourceScheme == powerfx",
          "group": "navigation@2"
        },
        {
          "command": "powerappsBridge.showPreview",
          "when": "resourceScheme == powerfx",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "powerappsBridge.goToControl",
          "when": "view == powerappsBridge.tree",
          "group": "1_nav@0"
        },
        {
          "command": "powerappsBridge.showPreview",
          "when": "view == powerappsBridge.tree",
          "group": "navigation@2"
        },
        {
          "command": "powerappsBridge.refreshTree",
          "when": "view == powerappsBridge.tree",
          "group": "navigation@3"
        },
        {
          "command": "powerappsBridge.goToFormula",
          "when": "view == powerappsBridge.tree",
          "group": "1_nav@1"
        },
        {
          "command": "powerappsBridge.searchFormulas",
          "when": "view == powerappsBridge.tree",
          "group": "1_nav@2"
        },
        {
          "command": "powerappsBridge.exportApp",
          "when": "view == powerappsBridge.tree",
          "group": "2_sync@1"
        },
        {
          "command": "powerappsBridge.expandTree",
          "when": "view == powerappsBridge.tree",
          "group": "2_sync@2"
        },
        {
          "command": "powerappsBridge.runLint",
          "when": "view == powerappsBridge.tree",
          "group": "3_tools@1"
        },
        {
          "command": "powerappsBridge.suggestNames",
          "when": "view == powerappsBridge.tree",
          "group": "3_tools@2"
        },
        {
          "command": "powerappsBridge.toggleFollow",
          "when": "view == powerappsBridge.tree",
          "group": "4_settings@1"
        },
        {
          "command": "powerappsBridge.showLog",
          "when": "view == powerappsBridge.tree",
          "group": "4_settings@2"
        },
        {
          "command": "powerappsBridge.help",
          "when": "view == powerappsBridge.tree",
          "group": "4_settings@3"
        }
      ],
      "commandPalette": [
        {
          "command": "powerappsBridge.selectControl",
          "when": "false"
        },
        {
          "command": "powerappsBridge.openFormula",
          "when": "false"
        },
        {
          "command": "powerappsBridge.revealInPreview",
          "when": "false"
        },
        {
          "command": "powerappsBridge.copyName",
          "when": "false"
        },
        {
          "command": "powerappsBridge.renameControl",
          "when": "powerappsBridge.connected"
        },
        {
          "command": "powerappsBridge.pickProperty",
          "when": "powerappsBridge.connected"
        },
        {
          "command": "powerappsBridge.findUsages",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "powerappsBridge.selectControl",
          "when": "webviewId == powerappsBridge.tree && webviewSection == control",
          "group": "1_nav@1"
        },
        {
          "command": "powerappsBridge.pickProperty",
          "when": "webviewId == powerappsBridge.tree && webviewSection == control",
          "group": "1_nav@2"
        },
        {
          "command": "powerappsBridge.revealInPreview",
          "when": "webviewId == powerappsBridge.tree && webviewSection == control",
          "group": "1_nav@3"
        },
        {
          "command": "powerappsBridge.findUsages",
          "when": "webviewId == powerappsBridge.tree && webviewSection == control",
          "group": "1_nav@4"
        },
        {
          "command": "powerappsBridge.renameControl",
          "when": "webviewId == powerappsBridge.tree && webviewSection == control",
          "group": "2_edit@1"
        },
        {
          "command": "powerappsBridge.copyName",
          "when": "webviewId == powerappsBridge.tree && webviewSection == control",
          "group": "9_copy@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "powerappsBridge.goToFormula",
        "key": "ctrl+alt+g"
      },
      {
        "command": "powerappsBridge.goToProperty",
        "key": "ctrl+alt+p",
        "when": "resourceScheme == powerfx"
      },
      {
        "command": "powerappsBridge.goToControl",
        "key": "ctrl+alt+f",
        "when": "powerappsBridge.connected"
      },
      {
        "command": "powerappsBridge.searchFormulas",
        "key": "ctrl+alt+shift+f",
        "when": "powerappsBridge.connected"
      }
    ],
    "views": {
      "powerapps": [
        {
          "id": "powerappsBridge.tree",
          "name": "%view.tree%",
          "type": "webview"
        },
        {
          "id": "powerappsBridge.props",
          "name": "%view.props%",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "powerapps",
          "title": "Power Apps X VS Code",
          "icon": "media/powerapps.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "powerappsBridge.start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "markdown": "%walkthrough.connect.media%"
            },
            "completionEvents": [
              "onContext:powerappsBridge.connected"
            ]
          },
          {
            "id": "select",
            "title": "%walkthrough.select.title%",
            "description": "%walkthrough.select.description%",
            "media": {
              "markdown": "%walkthrough.select.media%"
            },
            "completionEvents": [
              "onContext:powerappsBridge.hasSelection"
            ]
          },
          {
            "id": "preview",
            "title": "%walkthrough.preview.title%",
            "description": "%walkthrough.preview.description%",
            "media": {
              "markdown": "%walkthrough.preview.media%"
            },
            "completionEvents": [
              "onCommand:powerappsBridge.showPreview"
            ]
          },
          {
            "id": "navigate",
            "title": "%walkthrough.navigate.title%",
            "description": "%walkthrough.navigate.description%",
            "media": {
              "markdown": "%walkthrough.navigate.media%"
            },
            "completionEvents": [
              "onCommand:powerappsBridge.goToFormula",
              "onCommand:powerappsBridge.goToProperty"
            ]
          },
          {
            "id": "sidebar",
            "title": "%walkthrough.sidebar.title%",
            "description": "%walkthrough.sidebar.description%",
            "media": {
              "markdown": "%walkthrough.sidebar.media%"
            },
            "completionEvents": [
              "onView:powerappsBridge.tree"
            ]
          }
        ]
      }
    ],
    "snippets": [
      {
        "language": "powerfx",
        "path": "./snippets/powerfx.json"
      }
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
